# ---- Database ----
# SUPABASE: Dashboard > Connect. You get three strings; they are NOT the same.
#   Transaction pooler (port 6543)  -> DATABASE_URL. Use this for the app.
#   Session pooler     (port 5432)  -> DIRECT_DATABASE_URL. Used by db:push.
#   Direct (db.xxx.supabase.co)     -> IPv6 only. Vercel cannot reach it.
# Run `npm run db:check` and it will tell you which one you have pasted.
#
# NEON: use the pooled string (host contains "-pooler") and delete
# "&channel_binding=require" if the copy button included it — the driver
# forwards it to the server and the connection fails. Keep sslmode=require.
# Neon needs only DATABASE_URL; leave DIRECT_DATABASE_URL blank.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_DATABASE_URL=""

# ---- Dodo Payments ----
# Dashboard > Developer > API. Use a test_ key while developing.
DODO_PAYMENTS_API_KEY=""
# Dashboard > Developer > Webhooks > Secret key
DODO_WEBHOOK_SECRET=""
# The PWYW product you created (Products > new > enable "Pay What You Want", min $1)
DODO_PRODUCT_ID=""
# "test_mode" while developing, "live_mode" when you go live
DODO_ENVIRONMENT="test_mode"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="bidboard"
# A monitored address. Payment review checks this is reachable from your site.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Comma-separated secret for the /admin moderation actions
ADMIN_TOKEN="change-me"
